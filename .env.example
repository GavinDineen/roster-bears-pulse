# ---- Spend controls (all optional; defaults shown) ----
X_MONTHLY_BUDGET_USD=25
X_MAX_READS_PER_DAY=400
X_MAX_POSTS_PER_DAY=5
X_COLLECT_EVERY_MINUTES=180
X_MAX_RESULTS_PER_QUERY=20
X_QUERY_COUNT=2
AUTO_TWEET=false
ALLOW_URL_IN_TWEETS=false
X_ALLOW_UNAUTH_COLLECT=true
VIRAL_THRESHOLD=80

# ---- X / Twitter API credentials ----
# Reads use the bearer token. Writes (posting) use the 4 OAuth 1.0a keys.
X_APP_KEY=
X_APP_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=

# ---- Persistent storage (production) ----
# Leave blank for local dev (state falls back to .data/*.json files).
# On Vercel, add an Upstash Redis store via the Marketplace — it injects these.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Auth (The Desk gate) ----
# Members log in with MEMBER_PASSWORD. You log in with ADMIN_PASSWORD, which
# also unlocks the member view; add ?admin to the URL for the operator rail.
MEMBER_PASSWORD=
ADMIN_PASSWORD=
# Signs the session cookie. Any long random string. Falls back to ADMIN_PASSWORD.
AUTH_SECRET=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://therostercollective.com
NEXT_PUBLIC_PULSE_PATH=/intelligence/bears
CRON_SECRET=change-me
