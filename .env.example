# ============================================================
#  Bears Pulse — headless data service for The Desk
#  The Roster app (therostercollective.com) is the only caller.
#  It owns the user session and role; this service just needs the
#  shared secret below.
# ============================================================

# Shared secret between the Roster app and this service. Any long random string.
# Must match DESK_SERVICE_SECRET in the Roster app's server env.
DESK_SERVICE_SECRET=

# ---- Spend controls (all optional; defaults shown) ----
X_MONTHLY_BUDGET_USD=25
X_MAX_READS_PER_DAY=400
X_MAX_POSTS_PER_DAY=5
X_COLLECT_EVERY_MINUTES=180
X_MAX_RESULTS_PER_QUERY=20
X_QUERY_COUNT=2
AUTO_TWEET=false
ALLOW_URL_IN_TWEETS=false
VIRAL_THRESHOLD=80

# ---- X / Twitter API credentials (official path — the budget-gated fallback) ----
X_APP_KEY=
X_APP_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=

# ---- X read via the twscrape sidecar (PRIMARY path; free) ----
# When both are set, /api/collect reads X through the sidecar first and only
# falls back to the official API above (under the spend limits) on any failure.
# Leave blank to use the official API exclusively. See services/x-scrape/README.md.
X_SCRAPE_SERVICE_URL=
X_SCRAPE_SERVICE_SECRET=
# Optional — sidecar request timeout (ms). Default 30000; raise if your host
# has slow cold starts and you'd rather wait than fall back to the paid API.
X_SCRAPE_TIMEOUT_MS=

# ---- Persistent storage (production) ----
# Blank locally (falls back to .data/*.json). On Vercel, an Upstash Redis store
# injects these.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Cron ----
# Vercel Cron calls /api/cron with this bearer token.
CRON_SECRET=change-me
